{
    "$schema": "https://synodic.github.io/porringer/schema.json",
    "version": "1",
    "name": "Python Dev Environment",
    "description": "Linting, type-checking, and testing tools for Porringer development",
    "author": "Synodic Software",
    "url": "https://github.com/synodic/porringer",
    "packages": {
        "python": [
            {
                "name": "ruff",
                "description": "Fast Python linter and formatter"
            },
            {
                "name": "pyrefly",
                "description": "Python type checker"
            },
            "pytest",
            "pytest-asyncio"
        ],
        "system": [
            {
                "name": "GitHub.cli",
                "description": "GitHub CLI for pull requests, releases, and repository settings",
                "installer": "winget",
                "platforms": ["win32"],
                "group": "maintainer"
            },
            {
                "name": "gh",
                "description": "GitHub CLI for pull requests, releases, and repository settings",
                "installer": "brew",
                "platforms": ["darwin"],
                "group": "maintainer"
            },
            {
                "name": "gh",
                "description": "GitHub CLI for pull requests, releases, and repository settings",
                "installer": "apt",
                "platforms": ["linux"],
                "group": "maintainer"
            }
        ]
    },
    "tools": {
        "python": [
            {
                "name": "pdm",
                "description": "Python package and dependency manager"
            }
        ]
    },
    "groups": {
        "maintainer": {
            "description": "Repository administration and release tools"
        }
    }
}