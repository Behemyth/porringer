{
    "$schema": "https://synodic.github.io/porringer/schema.json",
    "version": "1",
    "name": "Soul Engine",
    "description": "A real-time rendering engine, built against local checkouts of every native dependency",
    "author": "Synodic Software",
    "url": "https://github.com/synodic/Soul-Engine",
    "runtimes": {
        "python": [
            "3.15"
        ]
    },
    "tools": {
        "python": [
            {
                "name": "pdm",
                "description": "Python package and dependency manager",
                "installer": "pipx"
            }
        ]
    },
    "packages": {
        "system": [
            {
                "name": {
                    "name": "KhronosGroup.VulkanSDK",
                    "constraint": "1.4.357.0"
                },
                "description": "Vulkan SDK, provides the Slang shader compiler",
                "installer": "winget",
                "platforms": [
                    "win32"
                ]
            }
        ]
    },
    "native": {
        "schema_version": 1,
        "root": "..",
        "default": "local",
        "packages": {
            "cppaste": {
                "url": "https://github.com/synodic/cppaste.git"
            },
            "honesty": {
                "url": "https://github.com/synodic/honesty.git"
            },
            "periapsis": {
                "url": "https://github.com/synodic/periapsis.git"
            },
            "portability": {
                "url": "https://github.com/synodic/portability.git"
            }
        }
    }
}
